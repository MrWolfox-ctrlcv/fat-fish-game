PORT=4180
NEWAPI_URL=http://127.0.0.1:3000
GAME_DB=./data/game.sqlite
GAME_ORIGINS=http://127.0.0.1:4180,http://localhost:4180

# Maximum retained arena rooms per process, including rooms waiting for players (1-8).
ARENA_MAX_ROOMS=2

# Optional account-quota billing for fish props and paid saves/extensions: $0.01 = 5000 quota per successful order.
# Management credentials belong only in a root-readable server environment file.
# This adapter supports a loopback NEWAPI_URL only. Never put these in browser code.
PROP_WALLET_ENABLED=0
PROP_WALLET_ADMIN_ID=
PROP_WALLET_ADMIN_TOKEN=

# Optional free AI companion. Keep credentials on the server; disabled by default.
COMPANION_ENABLED=0
COMPANION_API_URL=https://your-provider.example/v1/chat/completions
COMPANION_API_KEY=
COMPANION_MODEL=deepseek/deepseek-v4.1-flash
COMPANION_GLOBAL_DAILY=100
COMPANION_USER_DAILY=20

# Enable only after both game services have been updated and verified.
SUPPORTER_ENABLED=0
# Shared supporter entitlements: one $1 purchase covers both games (30 days, 3 slots each).
# Survivor reads the existing fish service, never a browser-supplied endpoint.
SUPPORTER_URL=http://127.0.0.1:4180/games/fat-fish/api/supporter
SUPPORTER_LOOKUP_ENABLED=1
# Turn off the optional aggregate analytics receiver when required.
SURVIVOR_ANALYTICS_ENABLED=1
